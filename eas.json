{
    "cli": {
        "version": ">= 5.9.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "channel": "preview"
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_APP_VERSION_CODE": "113",
                "EXPO_PUBLIC_APP_VERSION": "1.0.13"
            },
            "cache": {
                "key": "production-cache",
                "paths": [
                    "node_modules"
                ]
            }
        }
    },
    "submit": {
        "production": {}
    }
}